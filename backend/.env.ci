# Settings for the GitHub Actions run (.github/workflows/ci.yml). Nothing
# here is secret: the database and the key exist only inside the CI
# machine and are thrown away after each run. HTTPS uses a certificate made
# in the run by npm run cert:new, exactly as on a developer machine. No SMTP
# (sign-in codes are written to the backend's console) and no Key Vault.
# The workflow adds ENCRYPTION_KEY with npm run key:new.
PORT=4000
DATABASE_URL=postgresql://app_user:ci-only-password@localhost:5432/ics_project_2
JWT_SECRET=ci-only-jwt-secret-not-used-anywhere-else-0123456789
JWT_EXPIRES_IN=1h
APP_BASE_URL=https://localhost:4000
ML_SERVICE_URL=http://127.0.0.1:5001
FRONTEND_ORIGIN=https://localhost:5173
DEMO_ACCOUNT_PASSWORD=ci-demo-password
DEMO_EMAIL_BASE=ci@example.com
TLS_CERT_FILE=certs/localhost-cert.pem
TLS_KEY_FILE=certs/localhost-key.pem
