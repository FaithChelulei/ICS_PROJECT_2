# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://app_user:changeme@localhost:5432/ics_project_2

# JWT signing secret — generate a long random string, do not reuse examples
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# AES-256 keys for encrypting child records at rest (32 bytes, base64).
# Don't write these by hand -- run `npm run key:new`, which appends the
# next key here and makes it active without ever printing it.
#   ENCRYPTION_KEY          key #1 (original name, still supported)
#   ENCRYPTION_KEY_2, _3 .. later keys added by key:new
#   ENCRYPTION_ACTIVE_KEY_ID which key new data is encrypted with
#                           (defaults to the highest id present)
# Rotating: npm run key:new -> restart backend -> Admin > Encryption Keys >
# "Re-encrypt to active key" (or npm run key:reencrypt) -> delete the old
# key line once it shows 0 values. npm run key:status / key:verify check it.
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# SMTP settings for the risk-response confirmation emails and MFA codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM="Child Data Security System <no-reply@example.com>"

# Base URL this backend is reachable at — used to build the "This was me" /
# "This was NOT me" links in the risk-alert email.
APP_BASE_URL=http://localhost:4000

# Flask ML risk-scoring microservice (ml/service/app.py)
ML_SERVICE_URL=http://127.0.0.1:5001

# Origin the frontend is served from — the ONLY origin the API's CORS
# policy allows. Update if the frontend runs somewhere other than the Vite
# dev server default.
FRONTEND_ORIGIN=http://localhost:5173
