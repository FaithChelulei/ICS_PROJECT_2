.venv/
__pycache__/
*.pyc

# Raw CERT log files are too large for a normal GitHub push (file.csv is
# ~193MB, over GitHub's 100MB hard limit) and aren't needed to run the
# trained models — only to regenerate sessions_features.csv from scratch.
ml/data/logon.csv
ml/data/file.csv
ml/data/device.csv
# The processed sessions (57 MB) are a release download instead:
# https://github.com/FaithChelulei/ICS_PROJECT_2/releases/tag/data-v1
ml/data/processed/sessions_features.csv

desktop.ini
Thumbs.db
~$*

# Personal working notes -- not for the published repo
PROJECT_INDEX.md

# Backend (Node/Express)
backend/node_modules/
backend/.env
backend/npm-debug.log*
# Local TLS certificate + PRIVATE KEY (made by `npm run cert:new`)
backend/certs/
# Output of test runs (npm run test:perf etc.) -- regenerated each run
backend/test/results/

# Frontend (also covered by frontend/.gitignore -- repeated here so the
# root file alone is enough)
frontend/node_modules/
frontend/dist/
frontend/.env

# Local process logs from running the services
*.log

# Script output: stderr captures are noise (TensorFlow start-up warnings).
# Results worth keeping go in ml/results/, named after their script.
ml/scripts/*_log.txt
ml/scripts/*_err.txt

# Editor settings (machine-specific paths)
.vscode/
*.code-workspace
